<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Updates from GitHub Releases are handed to the system installer, the same way Aux Setup installs Aux -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <queries>
        <package android:name="dev.syavi.aux.setup" />
        <!-- Voice search asks whether a speech recognizer exists, apps only see the services they name -->
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" />
        </intent>
    </queries>
    <!-- The legacy SDK advertises media but routes playback through its projection service. -->
    <application android:name=".application.MyApplication" android:theme="@style/Theme.AppCompat"
        tools:ignore="MissingMediaBrowserServiceIntentFilter"
        android:label="@string/app_name" android:icon="@mipmap/ic_aux_launcher" android:roundIcon="@mipmap/ic_aux_launcher"
        android:allowBackup="false" android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">
        <activity android:name=".activity.MainPhoneActivity" android:exported="true" android:theme="@style/Theme.Tube"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".activity.SettingsPhoneActivity" android:exported="false" android:theme="@style/Theme.Tube" android:label="@string/settings" android:parentActivityName=".activity.MainPhoneActivity" />
        <activity android:name=".activity.MainCarActivity" android:exported="true" android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.car" android:launchMode="singleTask" />
        <service android:name="com.sya.tube.video.car.AuxProjectionService" android:exported="true" android:label="Aux" android:icon="@drawable/ic_aux">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>
        <service android:name=".service.MyMediaBrowserService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <!-- Media keys reach the active session directly, the old fallback receiver had no service to hand them to and crashed -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/updates" />
        </provider>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <!-- Compatibility metadata mirrors AAAD 2.8.5's normal APK repackager.
             These are manifest hints, not a Google Play signature or installer grant. -->
        <meta-data android:name="com.android.stamp.source" android:value="https://play.google.com/store" />
        <meta-data android:name="com.android.stamp.type" android:value="STAMP_TYPE_DISTRIBUTION_APK" />
        <meta-data android:name="com.android.vending.splits.required" android:value="false" />
    </application>
</manifest>
