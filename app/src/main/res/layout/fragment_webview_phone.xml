<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/tube_background">
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/home_button"
                    style="@style/TubeBarButton"
                    android:src="@drawable/tube_ic_home"
                    android:contentDescription="@string/phone_home"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/tube_ic_search"
                        android:tint="@color/tube_muted"
                        android:importantForAccessibility="no"/>
                    <EditText
                        android:id="@+id/edittext_url"
                        android:background="@null"
                        android:hint="@string/phone_search_hint"
                        android:textColorHint="@color/tube_muted"
                        android:textColor="@color/tube_on_surface"
                        android:textSize="15sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:inputType="text"
                        android:imeOptions="actionSearch"/>
                    <ImageButton
                        android:id="@+id/search_clear"
                        android:visibility="gone"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_round_ripple"
                        android:src="@drawable/tube_ic_close"
                        android:tint="@color/tube_muted"
                        android:contentDescription="@string/phone_clear_search"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/menu_button"
                    style="@style/TubeBarButton"
                    android:src="@drawable/tube_ic_more"
                    android:contentDescription="@string/phone_more"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:indeterminate="true"
                android:indeterminateTint="@color/tube_accent"
                android:layout_gravity="bottom"
                android:layout_marginBottom="-6dp"
                android:layout_width="match_parent"
                android:layout_height="12dp"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/car_hint"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="@drawable/bg_hint_card"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/phone_car_hint"
                android:textColor="@color/tube_on_surface"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/car_hint_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_round_ripple"
                android:src="@drawable/tube_ic_close"
                android:tint="@color/tube_muted"
                android:contentDescription="@string/phone_dismiss"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/recent_strip"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.thekirankumar.youtubeauto2.webview.VideoWebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/car_remote"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/full_screen_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
