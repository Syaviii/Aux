<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/highlighting_drawable"
    android:focusable="true"
    android:clickable="true"
    android:padding="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/tube_surface">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.thekirankumar.youtubeauto2.utils.AspectRatioFrameLayout
                android:id="@+id/bookmark_artwork"
                android:background="@color/tube_surface_high"
                android:layout_width="match_parent"
                android:layout_height="100dp">
                <ImageView
                    android:id="@+id/bookmark_thumbnail"
                    android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </com.thekirankumar.youtubeauto2.utils.AspectRatioFrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:minHeight="60dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/bookmark_favicon"
                    android:importantForAccessibility="no"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/bookmark_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tube_on_surface"
                    android:ellipsize="end"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <ImageButton
        android:layout_gravity="top|end"
        android:id="@+id/bookmark_delete"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_round_ripple"
        android:src="@drawable/tube_ic_close"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:tint="@color/tube_on_surface"/>
</FrameLayout>
