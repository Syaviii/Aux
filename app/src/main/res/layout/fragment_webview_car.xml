<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:background="@color/tube_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/full_screen_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.github.zagum.speechrecognitionview.RecognitionProgressView
                android:layout_gravity="center"
                android:id="@+id/speech_view"
                android:background="@color/tube_background"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <!-- Page tools on the left, the playing video's controls grouped in the middle, view controls on the right -->
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/toolbar"
                android:background="@color/tube_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/home_button"
                    android:contentDescription="YouTube home"
                    android:src="@drawable/tube_ic_home"
                    android:nextFocusLeft="@+id/native_video_settings"
                    android:nextFocusRight="@+id/search_youtube_button"
                    style="@style/CarBarButton"/>
                <ImageButton
                    android:id="@+id/search_youtube_button"
                    android:contentDescription="Search YouTube"
                    android:src="@drawable/tube_ic_search"
                    android:nextFocusLeft="@id/home_button"
                    android:nextFocusRight="@+id/voice_button"
                    style="@style/CarBarButton"/>
                <ImageButton
                    android:id="@+id/voice_button"
                    android:contentDescription="Voice search"
                    android:src="@drawable/tube_ic_mic"
                    android:nextFocusLeft="@id/search_youtube_button"
                    android:nextFocusRight="@+id/bookmark_button"
                    style="@style/CarBarButton"/>
                <ImageButton
                    android:id="@+id/bookmark_button"
                    android:contentDescription="Bookmarks"
                    android:src="@drawable/tube_ic_bookmarks"
                    android:nextFocusLeft="@id/voice_button"
                    android:nextFocusRight="@+id/library_button"
                    style="@style/CarBarButton"/>
                <ImageButton
                    android:id="@+id/library_button"
                    android:contentDescription="Library"
                    android:src="@drawable/tube_ic_library"
                    android:nextFocusLeft="@id/bookmark_button"
                    android:nextFocusRight="@+id/refresh_button"
                    style="@style/CarBarButton"/>
                <ImageButton
                    android:id="@+id/refresh_button"
                    android:contentDescription="Refresh page"
                    android:src="@drawable/tube_ic_refresh"
                    android:nextFocusLeft="@id/library_button"
                    android:nextFocusRight="@+id/native_previous_video"
                    style="@style/CarBarButton"/>
                <ImageView
                    android:src="@drawable/car_divider"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/car_media_group"
                    android:padding="2dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3.3">
                    <ImageButton
                        android:id="@+id/native_previous_video"
                        android:contentDescription="Previous video or restart"
                        android:src="@drawable/ic_video_previous"
                        android:nextFocusLeft="@id/refresh_button"
                        android:nextFocusRight="@+id/native_play_pause"
                        style="@style/CarBarButton"/>
                    <ImageButton
                        android:id="@+id/native_play_pause"
                        android:contentDescription="Play or pause video"
                        android:src="@drawable/ic_video_play"
                        android:nextFocusLeft="@id/native_previous_video"
                        android:nextFocusRight="@+id/native_next_video"
                        style="@style/CarBarButton"/>
                    <ImageButton
                        android:id="@+id/native_next_video"
                        android:contentDescription="Next video"
                        android:src="@drawable/ic_video_next"
                        android:nextFocusLeft="@id/native_play_pause"
                        android:nextFocusRight="@+id/fullscreen_button"
                        style="@style/CarBarButton"/>
                </LinearLayout>
                <ImageView
                    android:src="@drawable/car_divider"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageButton
                    android:id="@+id/fullscreen_button"
                    android:contentDescription="Fullscreen"
                    android:src="@drawable/tube_ic_fullscreen"
                    android:nextFocusLeft="@id/native_next_video"
                    android:nextFocusRight="@+id/native_video_settings"
                    style="@style/CarBarButton"/>
                <ImageButton
                    android:id="@+id/native_video_settings"
                    android:contentDescription="Video settings"
                    android:src="@drawable/tube_ic_tune"
                    android:nextFocusLeft="@id/fullscreen_button"
                    android:nextFocusRight="@id/home_button"
                    style="@style/CarBarButton"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/recent_strip"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/tube_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/webview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.thekirankumar.youtubeauto2.webview.VideoWebView
                android:id="@+id/web_view"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/voice_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <!-- A thin line at the very top of the page, the negative margin trims the bar's built in padding -->
            <ProgressBar
                android:layout_gravity="top"
                android:id="@+id/progress_bar"
                android:layout_marginTop="-6dp"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/tube_accent"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.thekirankumar.youtubeauto2.utils.CarEditText
                android:id="@+id/fake_edittext"
                android:visibility="invisible"
                android:layout_width="1px"
                android:layout_height="1px"
                android:imeOptions="actionDone"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical|end"
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/fullscreen_corner_controls"
        android:visibility="gone"
        android:paddingEnd="8dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <Button
            android:id="@+id/aspect_button"
            android:nextFocusLeft="@+id/bookmark_button"
            android:nextFocusDown="@+id/quality_button"
            android:text="contain"
            android:drawableStart="@drawable/tube_ic_aspect"
            style="@style/CarPill"/>
        <Button
            android:id="@+id/quality_button"
            android:nextFocusUp="@id/aspect_button"
            android:text="Quality: 720p"
            android:drawableStart="@drawable/tube_ic_tune"
            style="@style/CarPill"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
