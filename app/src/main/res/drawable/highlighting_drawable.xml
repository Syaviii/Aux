<?xml version="1.0" encoding="utf-8"?>
<!-- Car buttons sit on dark surfaces, rotary focus gets a white ring so it reads at a glance while driving -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#40FFFFFF"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#1FFFFFFF"/><stroke android:width="3dp" android:color="#FFFFFFFF"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#FF2A2A2A"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
