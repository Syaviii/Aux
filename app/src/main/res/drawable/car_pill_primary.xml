<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#FFCCCCCC"/><corners android:radius="28dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#FFF1F1F1"/><stroke android:width="3dp" android:color="#FFFF0033"/><corners android:radius="28dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#FFF1F1F1"/><corners android:radius="28dp"/></shape>
    </item>
</selector>
