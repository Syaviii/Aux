<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="ToolbarButton" parent="@android:style/Widget.ImageButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>

    <!-- Car toolbar buttons, small icons on a dark bar, rotary focus draws its ring through highlighting_drawable -->
    <style name="CarBarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/highlighting_drawable</item>
        <item name="android:tint">@color/tube_on_surface</item>
        <item name="android:nextFocusDown">@id/web_view</item>
    </style>

    <style name="CarPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tube_on_surface</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/tube_on_surface</item>
        <item name="android:background">@drawable/car_pill</item>
    </style>

    <style name="Theme.Tube.Settings" parent="Theme.AppCompat">
        <!-- The phone screens lay out below the status bar the way they always have, Android 15 would draw them under it -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="colorPrimary">@color/tube_background</item>
        <item name="colorPrimaryDark">@color/tube_background</item>
        <item name="colorAccent">@color/tube_accent</item>
        <item name="android:windowBackground">@color/tube_background</item>
        <item name="android:statusBarColor">@color/tube_background</item>
        <item name="android:navigationBarColor">@color/tube_background</item>
    </style>

    <!-- The phone screen draws its own top bar, an action bar would only stack a second one above it -->
    <style name="Theme.Tube" parent="Theme.Tube.Settings">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TubeBarButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_round_ripple</item>
        <item name="android:tint">@color/tube_on_surface</item>
    </style>
</resources>
